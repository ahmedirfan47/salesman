# ---- Backend ----
# Local dev uses the docker-compose Postgres below.
DATABASE_URL=postgresql+asyncpg://salesman:salesman@localhost:5432/salesman

# Generate a long random string, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

ENVIRONMENT=development
# CORS is a JSON array
CORS_ORIGINS=["http://localhost:3000"]

# Background jobs: the worker runs inside the API process by default.
# Set to false only if you run `python -m app.jobs.worker` as a separate service.
JOB_WORKER_ENABLED=true

# AI prospecting: Google Maps search for new shops (optional).
# A Google Maps Platform key with "Places API (New)" enabled. Empty = search off.
GOOGLE_MAPS_API_KEY=
PROSPECT_REGION_CODE=SA
PROSPECT_DEFAULT_COUNTRY_CODE=966

# Error tracking (optional): paste your Sentry project's DSN to enable.
SENTRY_DSN=